{
  "name": "discord-hub-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../../packages/hub-pg-migrate",
    "dev": "tsx watch --exclude \"../../packages/**\" src/index.ts",
    "prebuild": "npm run build --prefix ../../packages/hub-pg-migrate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clanker/hub-pg-migrate": "file:../../packages/hub-pg-migrate",
    "@hono/node-server": "^1.19.0",
    "@types/pg": "^8.20.0",
    "@y/websocket-server": "^0.1.5",
    "dotenv": "^16.4.7",
    "hono": "^4.11.3",
    "jose": "^6.1.3",
    "pg": "^8.20.0",
    "ws": "^8.20.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7",
    "@electric-sql/pglite": "^0.3.16"
  }
}
