# Discord application: https://discord.com/developers/applications
# OAuth2 → Redirects: must match DISCORD_REDIRECT_URI exactly (including trailing slash policy).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Dev (Vite default): browser hits Vite; /api is proxied to this API.
# With Caddy at http://dev.clanker.discord use that host for BOTH lines below, e.g.:
# DISCORD_REDIRECT_URI=http://dev.clanker.discord/api/auth/discord/callback
# FRONTEND_URL=http://dev.clanker.discord
#
# Om du delar .env med någon: de MÅSTE ändra dessa till sin egen URL (localhost vs 127.0.0.1,
# rätt port — 5175 om `npm run dev -w discord-hub-web -- --mode direct`, 5173 annars) och lägga
# exakt samma redirect i Discord Portal → OAuth2 → Redirects. Annars: OAuth-fel eller 502.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
# Where users land after successful login (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Cookie Secure flag: default follows NODE_ENV (secure in production). If you run
# production over plain HTTP, set COOKIE_SECURE=0 or OAuth state cookies are dropped.
# COOKIE_SECURE=0

# Log OAuth callback failures to stderr even when NODE_ENV=production (troubleshooting).
# DISCORD_OAUTH_DEBUG=1

# Random secret for signing session cookies (e.g. openssl rand -hex 32).
# Also used to derive the AES key for the encrypted OAuth token cookie unless DISCORD_TOKEN_ENCRYPTION_KEY is set.
SESSION_SECRET=

# Space-separated OAuth2 scopes (default: identify). Adding scopes requires users to sign in again.
# Examples: identify guilds email connections
# DISCORD_OAUTH_SCOPES=identify

# Optional: consent (always show consent) or none (skip screen when already authorized). See Discord OAuth2 docs.
# DISCORD_OAUTH_PROMPT=consent

# Comma-separated path prefixes allowed for GET /api/discord/... → https://discord.com/api/v10/...
# Default: users/@me,oauth2/@me
# DISCORD_PROXY_USER_PREFIXES=users/@me,oauth2/@me

# --- Bot (REST proxy + guild summary + gateway) ---
# Create a bot under your application → Bot → Reset Token. Never commit this value.
# Invite URL (adjust permissions): https://discord.com/oauth2/authorize?client_id=CLIENT_ID&permissions=0&scope=bot%20applications.commands
# DISCORD_BOT_TOKEN=

# Riot Games API key for League lookups (Developer Portal). Required for /api/integrations/league/sync.
# Never commit this value. Development keys expire, so expect to refresh it regularly.
# RIOT_API_KEY=

# League periodic Riot sync in API process (default off). Manual sync via POST /api/integrations/league/sync works either way.
# LEAGUE_AUTO_SYNC_ENABLED=1

# League auto-sync: max match IDs to fetch per user per cycle (paginated, 100 IDs per Riot request; Riot caps history ~1000).
# LEAGUE_MATCH_FETCH_COUNT=50
# LEAGUE_SYNC_INTERVAL_MS=600000
# Delay between Riot calls in auto-sync. Default ~1200 ms (typical app limit 100 req / 2 min). Production app: try 100.
# LEAGUE_CALL_DELAY_MS=1200
# LEAGUE_USER_DELAY_MS=300

# Manual POST /api/integrations/league/sync: max match IDs to list (1–1000). Fetches match details only for IDs not yet in DB.
# LEAGUE_MANUAL_SYNC_MATCH_MAX=1000
# How many newest matches to store in the live snapshot JSON (stats still use full DB history).
# LEAGUE_SNAPSHOT_RECENT_MATCHES=50
# Delay (ms) between Riot requests during manual sync. Default ~1200 (typical app limit 100/2min + 20/s). Production app: try 50–120.
# LEAGUE_MANUAL_RIOT_DELAY_MS=1200
# Max 429 retries per single Riot request (each waits Retry-After or backoff).
# RIOT_429_MAX_RETRIES=12

# Comma-separated prefixes for /api/bot/discord/* proxy (default: guilds/,channels/)
# DISCORD_PROXY_BOT_PREFIXES=guilds/,channels/

# Recommended in production: comma-separated guild snowflakes users may query via /api/bot/guild/:id/summary and /api/bot/live/guild/:id
# Empty = no allowlist (any guild the bot can see — use only in trusted dev).
# DISCORD_HUB_ALLOWED_GUILD_IDS=123456789012345678

# If 1/true: verify session user is a guild member via bot REST (extra Discord call per request).
# DISCORD_HUB_ENFORCE_GUILD_MEMBERSHIP=0

# Live voice (/api/bot/live/*) reads bot.guild_voice_states + bot.runtime_status written by discord-bot.
# hub-api no longer opens its own Discord gateway (DISCORD_GATEWAY_GUILD_IDS / DISCORD_GATEWAY_INTENTS are ignored).

# Optional: 32+ UTF-8 bytes dedicated key for encrypting discord_oauth_tokens cookie (otherwise derived from SESSION_SECRET via HKDF).
# DISCORD_TOKEN_ENCRYPTION_KEY=

# Bind address: default 127.0.0.1 in development, 0.0.0.0 when NODE_ENV=production (e.g. Docker).
# Set to 0.0.0.0 if you need LAN access while NODE_ENV is not production.
# DISCORD_HUB_API_LISTEN_HOST=127.0.0.1

# Optional; default 3001. discord-hub-web Vite läser denna fils PORT för /api-proxy under dev (se vite.config.ts).
# PORT=3001
# Om du sätter PORT här: du behöver inte längre spegla den i rot-.env — utom om du vill tvinga annat med DISCORD_HUB_API_DEV_PORT där.
# Om API inte körs eller proxyn pekar fel port: 502 Bad Gateway på /api (inkl. OAuth-callback) efter Discord-inloggning.

# Optional websocket port for shared wheel collaboration (defaults to PORT + 1).
# WHEEL_COLLAB_PORT=3002

# --- Musikbot (discord-bot) — hub-api proxar play/skip/kö hit ---
# Utan denna får musiksidan / dashboard „Music bot not configured” eller 503.
# discord-bot måste köra samtidigt (`npm run dev:discord-bot` eller Docker). Standardport 3012.
# Lokalt (API och bot på samma maskin):
# MUSIC_BOT_HTTP_URL=http://127.0.0.1:3012
# Delad hemlighet mot botens HTTP (header X-Clanker-Secret). Samma värde som BOT_HTTP_SECRET i botens miljö.
# Generera: openssl rand -hex 32   (eller: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# BOT_HTTP_SECRET=
# Om du byter MUSIC_BOT_HTTP_PORT i botten: använd samma port här.
# När denna är satt: GET musik/kö och borttag ur kö proxas mot boten (samma sanning som botens DATABASE_URL), så flera hub-api kan dela en musikbot utan gemensam hub-Postgres för just kön.

# --- PostgreSQL (optional until API persists data in DB) ---
# Same machine as API, API in Docker Compose: use host clanker-db (see root .env.example).
# API on Pi, Postgres on Windows desktop: use desktop LAN IP and POSTGRES_* you set there.
# Use POSTGRES_DB name in the path (default in compose: clanker_discord). Devtools uses a second DB on the same port.
# DATABASE_URL=postgresql://clanker:PASSWORD@127.0.0.1:5432/clanker_discord
