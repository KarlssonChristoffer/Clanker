# Bot token: Discord Developer Portal → din app → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Application ID: Developer Portal → General Information → Application ID
# Samma värde som DISCORD_CLIENT_ID i rot-.env
DISCORD_APPLICATION_ID=

# PostgreSQL — samma connection string som discord-hub-api använder.
# Lokalt npm utan Docker-nätverk:
# DATABASE_URL=postgresql://clanker:<lösenord>@127.0.0.1:5432/clanker_discord
# Om Postgres kör i Docker (clanker-db):
# DATABASE_URL=postgresql://clanker:<lösenord>@clanker-db:5432/clanker_discord
# Bot på Raspberry Pi, Postgres på workstation (LAN, POSTGRES_BIND_ADDRESS=0.0.0.0 + brandvägg):
# DATABASE_URL=postgresql://clanker:<lösenord>@192.168.x.x:5432/clanker_discord
# Specialtecken i lösenord måste URL-kodas (t.ex. encodeURIComponent i JS, eller manuellt %21 för !).
DATABASE_URL=

# Valfritt: om SQL-migrationer inte ligger bredvid dist (t.ex. egen image) — annars används ../migrations eller monorepo apps/discord-hub-api/migrations.
# CLANKER_HUB_MIGRATIONS_DIR=/absolut/sökväg/till/migrations

# Lokalt HTTP för hub → bot (play/skip/…). Om 3012 är upptagen (t.ex. discord-bot i Docker): byt port här och i rot-.env MUSIC_BOT_HTTP_URL.
# `npm run dev` / `dev:once` kör `scripts/kill-dev-ports.mjs music-bot` i predev — dödar gammal tsx/node som fortfarande lyssnar (vanligt på Windows efter stängd terminal).
# MUSIC_BOT_HTTP_PORT=3012
# Endast om en annan maskin/container ska anropa bot-HTTP: 0.0.0.0 — annars 127.0.0.1 (standard). Kräver då BOT_HTTP_SECRET (se nedan).
# MUSIC_BOT_HTTP_BIND=0.0.0.0
# Delad hemlighet: alla musik-endpoints kräver headern X-Clanker-Secret med detta värde (hub-api skickar den).
# Utan hemlighet svarar boten bara när den lyssnar på 127.0.0.1; på 0.0.0.0 blir musik-endpoints 503.
# GET /health kräver ingen hemlighet: {discord, db, jev, uptime, version}, HTTP 503 om Discord eller DB är nere.
# BOT_HTTP_SECRET=

# Loggning (pino): JSON i produktion (NODE_ENV=production), färgad text i dev. trace|debug|info|warn|error|fatal
# LOG_LEVEL=info
# LOG_PRETTY=0   # tvinga JSON även i dev

# Slash-kommandon registreras bara när definitionerna ändrats (hash i bot.command_registrations).
# DISCORD_GUILD_ID kan vara en kommaseparerad lista (t.ex. prod-servern + Hermes för test). Tom = globala kommandon.
# DISCORD_GUILD_ID=
# Tvinga omregistrering vid nästa start:
# DISCORD_FORCE_COMMAND_SYNC=1

# Windows: bot sätter ipv4first för DNS som standard (trasig IPv6 kan blockera röst). Sätt till 0 för att stänga av:
# DISCORD_VOICE_IPV4_FIRST=0

# Spotify (spellistor/låtar via API → YouTube). Personliga spellistor kräver ofta användar-OAuth; botten använder client credentials.
# Många Spotify-redaktionella/algorithmiska spellistor ger 403 i Web API för nya appar (nov 2024); botten faller då tillbaka till open.spotify.com/embed (SSR).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Marknad för spelliste-spår (ISO 3166-1 alpha-2), standard US om utelämnad:
# SPOTIFY_DEFAULT_MARKET=SE

# Valfritt: egen ffmpeg (om du inte vill använda npm-paketet ffmpeg-static). Annars sätter botten FFMPEG_PATH
# från ffmpeg-static åt @discordjs/voice (annars: „FFmpeg/avconv not found” på Windows utan ffmpeg i PATH).
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
#
# Om yt-dlp.exe saknas under node_modules (ENOENT / exit -4058): från repots rot kör
#   npm run rebuild:ytdlp -w discord-bot
# eller winget install yt-dlp och sätt full sökväg:
# YTDLP_PATH=C:\path\to\yt-dlp.exe
# Extra argument till yt-dlp (mellanslagsseparerade). Docker-imagen sätter "--js-runtimes node" (YouTube kräver en JS-runtime).
# YTDLP_EXTRA_ARGS=--js-runtimes node
# 1 = kör `yt-dlp --update` i bakgrunden vid start (standard i Docker-imagen; fungerar bara för release-binärer).
# YTDLP_AUTO_UPDATE=1
# Valfritt: egen User-Agent vid embed-fallback om Spotify blockerar standard (sällan):
# SPOTIFY_EMBED_USER_AGENT=Mozilla/5.0 ...
# Parallella YouTube-sökningar när Spotify-spellista mappas till YouTube (1–24, standard 12). Högre = snabbare; för mycket kan ge rate limits.
# MUSIC_PLAYLIST_SEARCH_CONCURRENCY=16
