{
  "name": "discord-bot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-prism-ffmpeg-env.mjs",
    "predev": "node ../../scripts/kill-dev-ports.mjs music-bot && npm run build --prefix ../../packages/hub-pg-migrate",
    "dev": "tsx watch --exclude \"../../packages/**\" --exclude \"**/node_modules/**\" src/index.ts",
    "dev:once": "node ../../scripts/kill-dev-ports.mjs music-bot && tsx src/index.ts",
    "prebuild": "npm run build --prefix ../../packages/hub-pg-migrate",
    "build": "tsc -p tsconfig.json",
    "rebuild:ytdlp": "node scripts/rebuild-ytdlp.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clanker/hub-pg-migrate": "file:../../packages/hub-pg-migrate",
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "@hono/node-server": "^1.13.7",
    "@snazzah/davey": "^0.1.11",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "hono": "^4.7.5",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.1.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "play-dl": "^1.9.7",
    "youtube-dl-exec": "^3.1.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7"
  }
}
